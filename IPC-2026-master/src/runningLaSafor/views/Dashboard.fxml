<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="runningLaSafor.controllers.DashboardController">

    <!-- ══════════════════════════════════════════
         TOP BAR
    ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER" styleClass="top-bar">
            <Button fx:id="closeBtn" onAction="#handleClose" styleClass="top-btn,close-btn" text="✕" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="dateLabel" styleClass="date-label" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="usernameLabel" styleClass="username-label" />
                <Button fx:id="avatarBtn" onAction="#handleAvatarClick" styleClass="avatar-btn" />
                <Button fx:id="logoutBtn" onAction="#handleLogout" styleClass="top-btn,logout-btn" text="⏏" />
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════
         LEFT SIDEBAR
    ══════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar" spacing="0" styleClass="sidebar">

            <!-- Logo / App name -->
            <HBox fx:id="logoBox" alignment="CENTER_LEFT" spacing="12" styleClass="logo-box">
                <Label styleClass="logo-icon" text="🏃" textFill="#4ade80" />
                <Label fx:id="appNameLabel" styleClass="app-name" text="Running la Safor" />
            </HBox>

            <!-- Toggle button -->
            <Button fx:id="sidebarToggleBtn" onAction="#handleSidebarToggle" styleClass="sidebar-toggle-btn" text="◀" />

            <Separator styleClass="sidebar-separator" />

            <!-- GENERAL section -->
            <Label fx:id="generalLabel" styleClass="sidebar-section-label" text="GENERAL" />

            <Button fx:id="dashboardBtn" onAction="#handleDashboard" styleClass="sidebar-btn,sidebar-btn-active">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="🏠" textFill="#e4e4e4" />
                        <Label fx:id="dashboardLabel" styleClass="sidebar-btn-text" text="Dashboard" />
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="activitiesBtn" onAction="#handleActividades" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="📋" textFill="#e4e4e4" />
                        <Label fx:id="actividadesLabel" styleClass="sidebar-btn-text" text="Actividades" />
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="historialBtn" onAction="#handleHistorial" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="📅" textFill="#e4e4e4" />
                        <Label fx:id="historialLabel" styleClass="sidebar-btn-text" text="Historial Sesiones" />
                    </HBox>
                </graphic>
            </Button>

            <Separator styleClass="sidebar-separator" />

            <!-- EXPLORAR section -->
            <Label fx:id="explorarLabel" styleClass="sidebar-section-label" text="EXPLORAR" />

            <Button fx:id="mapasBtn" onAction="#handleMapas" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="🗺" textFill="#e4e4e4" />
                        <Label fx:id="mapasLabel" styleClass="sidebar-btn-text" text="Gestión de Mapas" />
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="estadisticasBtn" onAction="#handleEstadisticas" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="📈" textFill="#e4e4e4" />
                        <Label fx:id="estadisticasLabel" styleClass="sidebar-btn-text" text="Estadísticas Mes" />
                    </HBox>
                </graphic>
            </Button>

            <Separator styleClass="sidebar-separator" />

            <!-- USUARIO section -->
            <Label fx:id="usuarioLabel" styleClass="sidebar-section-label" text="USUARIO" />

            <Button fx:id="perfilBtn" onAction="#handlePerfil" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="⚙" textFill="#e4e4e4" />
                        <Label fx:id="perfilLabel" styleClass="sidebar-btn-text" text="Configuración Perfil" />
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════
         CENTER — main content
    ══════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <VBox fx:id="mainContent" spacing="24" styleClass="main-content">
                <padding><Insets bottom="36" left="40" right="40" top="36" /></padding>

                <!-- Greeting -->
                <VBox spacing="6">
                    <Label fx:id="greetingLabel" styleClass="greeting-title" />
                    <Label styleClass="greeting-sub" text="¿Listo para una nueva ruta?" />
                </VBox>

                <!-- Stats cards row -->
                <HBox spacing="20">
                    <!-- Distancia mes -->
                    <VBox spacing="10" styleClass="stat-card,stat-card-green" HBox.hgrow="ALWAYS">
                        <Label styleClass="stat-icon" text="🚴" />
                        <Label styleClass="stat-label" text="DISTANCIA MES" />
                        <Label fx:id="distanciaLabel" styleClass="stat-value" text="— km" />
                    </VBox>

                    <!-- Tiempo total -->
                    <VBox spacing="10" styleClass="stat-card,stat-card-blue" HBox.hgrow="ALWAYS">
                        <Label styleClass="stat-icon" text="⏱" />
                        <Label styleClass="stat-label" text="TIEMPO TOTAL" />
                        <Label fx:id="tiempoLabel" styleClass="stat-value" text="—:——" />
                    </VBox>

                    <!-- Ascenso total -->
                    <VBox spacing="10" styleClass="stat-card,stat-card-orange" HBox.hgrow="ALWAYS">
                        <Label styleClass="stat-icon" text="⚠" />
                        <Label styleClass="stat-label" text="ASCENSO TOTAL" />
                        <Label fx:id="ascensoLabel" styleClass="stat-value" text="— m" />
                    </VBox>
                </HBox>

                <!-- Import GPX card -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="import-card">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label styleClass="import-title" text="Registra tu nueva ruta" />
                        <Label styleClass="import-sub" text="Sube tu fichero GPX para analizar tu entrenamiento." />
                    </VBox>
                    <Button fx:id="importGpxBtn" onAction="#handleImportGPX" styleClass="import-btn" text="⬆  IMPORTAR GPX" />
                </HBox>

                <!-- Recent activities -->
                <VBox spacing="14">
                    <Label styleClass="section-title" text="Actividades Recientes" />
                    <VBox fx:id="activitiesContainer" spacing="10" />
                    <Label fx:id="noActivitiesLabel" managed="false" styleClass="no-activities-label" text="No hay actividades recientes." visible="false" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
