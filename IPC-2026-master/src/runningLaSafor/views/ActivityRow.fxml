<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ActivityRow.fxml — reusable card for each recent activity -->

<HBox alignment="CENTER_LEFT" spacing="16" styleClass="activity-row" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="runningLaSafor.controllers.ActivityRowController">
    <padding><Insets bottom="14" left="18" right="18" top="14" /></padding>

    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="activityName" styleClass="activity-name" />
        <Label fx:id="activityDate" styleClass="activity-date" />
    </VBox>

    <VBox alignment="CENTER" spacing="2">
        <Label styleClass="activity-meta-label" text="DISTANCIA" />
        <Label fx:id="activityDistance" styleClass="activity-meta-value" />
    </VBox>

    <VBox alignment="CENTER" spacing="2">
        <Label styleClass="activity-meta-label" text="DURACIÓN" />
        <Label fx:id="activityDuration" styleClass="activity-meta-value" />
    </VBox>

    <VBox alignment="CENTER" spacing="2">
        <Label styleClass="activity-meta-label" text="ASCENSO" />
        <Label fx:id="activityElevation" styleClass="activity-meta-value" />
    </VBox>

    <Button fx:id="viewBtn" onAction="#handleView" styleClass="activity-view-btn" text="›" />
</HBox>
