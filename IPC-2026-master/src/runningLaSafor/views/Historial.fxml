<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="runningLaSafor.controllers.HistorialController">

    <!-- ══════════════════════════════════════════
         TOP BAR
    ══════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER" styleClass="top-bar">
            <Button fx:id="closeBtn" onAction="#handleClose" styleClass="top-btn,close-btn" text="✕" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="dateLabel" styleClass="date-label" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="usernameLabel" styleClass="username-label" />
                <Button fx:id="avatarBtn" onAction="#handleAvatarClick" styleClass="avatar-btn" />
                <Button fx:id="logoutBtn" onAction="#handleLogout" styleClass="top-btn,logout-btn" text="⏏" />
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════
         LEFT SIDEBAR
    ══════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebar" spacing="0" styleClass="sidebar">

            <!-- Logo / App name -->
            <HBox fx:id="logoBox" alignment="CENTER_LEFT" spacing="12" styleClass="logo-box">
                <Label styleClass="logo-icon" text="🏃" textFill="#4ade80" />
                <Label fx:id="appNameLabel" styleClass="app-name" text="Running la Safor" />
            </HBox>

            <!-- Toggle button -->
            <Button fx:id="sidebarToggleBtn" onAction="#handleSidebarToggle" styleClass="sidebar-toggle-btn" text="◀" />

            <Separator styleClass="sidebar-separator" />

            <!-- GENERAL section -->
            <Label fx:id="generalLabel" styleClass="sidebar-section-label" text="GENERAL" />

            <Button fx:id="dashboardBtn" onAction="#handleDashboard" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="🏠" textFill="#e4e4e4" />
                        <Label fx:id="dashboardLabel" styleClass="sidebar-btn-text" text="Dashboard" />
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="activitiesBtn" onAction="#handleActividades" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="📋" textFill="#e4e4e4" />
                        <Label fx:id="actividadesLabel" styleClass="sidebar-btn-text" text="Actividades" />
                    </HBox>
                </graphic>
            </Button>

            <!-- Historial activo -->
            <Button fx:id="historialBtn" onAction="#handleHistorial" styleClass="sidebar-btn,sidebar-btn-active">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="📅" textFill="#e4e4e4" />
                        <Label fx:id="historialLabel" styleClass="sidebar-btn-text" text="Historial Sesiones" />
                    </HBox>
                </graphic>
            </Button>

            <Separator styleClass="sidebar-separator" />

            <!-- EXPLORAR section -->
            <Label fx:id="explorarLabel" styleClass="sidebar-section-label" text="EXPLORAR" />

            <Button fx:id="mapasBtn" onAction="#handleMapas" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="🗺" textFill="#e4e4e4" />
                        <Label fx:id="mapasLabel" styleClass="sidebar-btn-text" text="Gestión de Mapas" />
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="estadisticasBtn" onAction="#handleEstadisticas" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="📈" textFill="#e4e4e4" />
                        <Label fx:id="estadisticasLabel" styleClass="sidebar-btn-text" text="Estadísticas Mes" />
                    </HBox>
                </graphic>
            </Button>

            <Separator styleClass="sidebar-separator" />

            <!-- USUARIO section -->
            <Label fx:id="usuarioLabel" styleClass="sidebar-section-label" text="USUARIO" />

            <Button fx:id="perfilBtn" onAction="#handlePerfil" styleClass="sidebar-btn">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label styleClass="sidebar-icon" text="⚙" textFill="#e4e4e4" />
                        <Label fx:id="perfilLabel" styleClass="sidebar-btn-text" text="Configuración Perfil" />
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════
         CENTER — contenido Historial
    ══════════════════════════════════════════ -->
    <center>
        <VBox spacing="16.0" styleClass="historial-content">
            <padding>
                <Insets bottom="36.0" left="40.0" right="40.0" top="36.0" />
            </padding>
            <VBox prefHeight="55.0" prefWidth="535.0">
                <children>
                    <Label styleClass="historial-title" text="Historial de sesiones" />
                    <Label alignment="BOTTOM_CENTER" prefHeight="32.0" prefWidth="182.0" styleClass="historial-sub" text="Registro de uso de la aplicación" />
                </children>
            </VBox>

            <!-- Tarjetas de resumen (fila superior) -->
            <HBox prefHeight="114.0" prefWidth="696.0" spacing="12.0">
                <VBox prefHeight="114.0" prefWidth="0.0" styleClass="hist-stat-card" HBox.hgrow="ALWAYS">
               <HBox prefHeight="100.0" prefWidth="200.0">
                  <children>
                     <Label minWidth="18.0" prefHeight="19.0" prefWidth="30.0" styleClass="sidebar-icon" text="📅" textFill="#e4e4e4" />
                          <Label maxWidth="1.7976931348623157E308" prefHeight="28.0" prefWidth="50.0" styleClass="hist-stat-title" text="Total&#10;sesiones" wrapText="true">
                        <HBox.margin>
                           <Insets left="10.0" />
                        </HBox.margin></Label>
                  </children>
               </HBox>
                    <HBox prefHeight="52.0" prefWidth="100.0">
                        <children>
                            <Label fx:id="statTotalSesiones" prefHeight="32.0" prefWidth="34.0" styleClass="hist-stat-value" text="0" wrapText="true">
                        <HBox.margin>
                           <Insets left="8.0" />
                        </HBox.margin></Label>
                            <Label prefHeight="52.0" prefWidth="46.0" styleClass="hist-stat-unit" text="sesiones" wrapText="true" />
                        </children>
                    </HBox>
                </VBox>
                <VBox prefHeight="114.0" prefWidth="38.0" styleClass="hist-stat-card" HBox.hgrow="ALWAYS">
               <HBox prefHeight="100.0" prefWidth="200.0">
                  <children>
                     <Label prefHeight="30.0" prefWidth="30.0" styleClass="sidebar-icon" text="⬇" textFill="#e4e4e4" />
                          <Label maxWidth="1.7976931348623157E308" styleClass="hist-stat-title" text="Actividades&#10;importadas" wrapText="true">
                        <HBox.margin>
                           <Insets left="10.0" />
                        </HBox.margin></Label>
                  </children>
               </HBox>
                    <HBox prefHeight="52.0" prefWidth="93.0">
                        <children>
                            <Label fx:id="statImportadas" prefHeight="32.0" prefWidth="34.0" styleClass="hist-stat-value" text="0" wrapText="true">
                        <HBox.margin>
                           <Insets left="8.0" />
                        </HBox.margin></Label>
                            <Label prefHeight="91.0" prefWidth="26.0" styleClass="hist-stat-unit" text="total" wrapText="true" />
                        </children>
                    </HBox>
                </VBox>
                <VBox prefHeight="114.0" prefWidth="0.0" styleClass="hist-stat-card" HBox.hgrow="ALWAYS">
               <HBox prefHeight="100.0" prefWidth="200.0">
                  <children>
                     <Label prefHeight="30.0" prefWidth="30.0" styleClass="sidebar-icon" text="👁" textFill="#e4e4e4" />
                          <Label maxWidth="1.7976931348623157E308" styleClass="hist-stat-title" text="Actividades&#10;visitadas" wrapText="true">
                        <HBox.margin>
                           <Insets left="10.0" />
                        </HBox.margin></Label>
                  </children>
               </HBox>
                    <HBox prefHeight="67.0" prefWidth="100.0">
                        <children>
                            <Label fx:id="statVistas" prefHeight="32.0" prefWidth="34.0" styleClass="hist-stat-value" text="0" wrapText="true">
                        <HBox.margin>
                           <Insets left="8.0" />
                        </HBox.margin></Label>
                            <Label prefHeight="104.0" prefWidth="26.0" styleClass="hist-stat-unit" text="total" wrapText="true" />
                        </children>
                    </HBox>
                </VBox>
                <VBox prefHeight="114.0" prefWidth="0.0" styleClass="hist-stat-card" HBox.hgrow="ALWAYS">
               <HBox prefHeight="100.0" prefWidth="200.0">
                  <children>
                     <Label prefHeight="30.0" prefWidth="30.0" styleClass="sidebar-icon" text="📍" textFill="#e4e4e4" />
                          <Label maxWidth="1.7976931348623157E308" styleClass="hist-stat-title" text="Anotaciones&#10;creadas" wrapText="true">
                        <HBox.margin>
                           <Insets left="10.0" />
                        </HBox.margin></Label>
                  </children>
               </HBox>
                    <HBox prefHeight="100.0" prefWidth="200.0">
                        <children>
                            <Label fx:id="statAnotaciones" prefHeight="41.0" prefWidth="34.0" styleClass="hist-stat-value" text="0" wrapText="true">
                        <HBox.margin>
                           <Insets left="8.0" />
                        </HBox.margin></Label>
                            <Label prefHeight="74.0" prefWidth="25.0" styleClass="hist-stat-unit" text="total" wrapText="true" />
                        </children>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Fila de filtros / cabecera -->
            <HBox alignment="CENTER_LEFT" prefHeight="11.0" prefWidth="535.0" spacing="12.0">
                <Label prefHeight="9.0" prefWidth="143.0" styleClass="hist-section-title" text="Sesiones registradas" />
            </HBox>

                  <!-- Tabla de sesiones -->
            <TableView fx:id="tablaSesiones" prefHeight="222.0" prefWidth="535.0" styleClass="hist-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="160.0" text="Fecha" />
                    <TableColumn prefWidth="100.0" text="Duración" />
                    <TableColumn prefWidth="90.0" text="Importadas" />
                    <TableColumn prefWidth="90.0" text="Vistas" />
                    <TableColumn prefWidth="90.0" text="Anotaciones" />
                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>

            <!-- Totales acumulados -->
            <HBox prefHeight="41.0" prefWidth="535.0" spacing="16.0" styleClass="hist-total-row">
            <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                      <Label fx:id="labelTotalHeader" styleClass="hist-total-label" text="Totales acumulados" wrapText="true" />
               </children>
            </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="labelSumaImportadas" styleClass="hist-total-value" text="0" />
                        <Label styleClass="hist-total-unit" text="importadas" />
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="labelSumaVistas" styleClass="hist-total-value" text="0" />
                        <Label styleClass="hist-total-unit" text="vistas" />
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="labelSumaAnotaciones" styleClass="hist-total-value" text="0" />
                        <Label styleClass="hist-total-unit" text="anotaciones" />
                    </children>
                </VBox>
            </HBox>

        </VBox>
    </center>
   <stylesheets>
      <URL value="@../css/dashboard.css" />
   </stylesheets>

</BorderPane>
